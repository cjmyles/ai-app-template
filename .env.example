# Web (Next.js / Auth.js)
AUTH_SECRET="change-me"
# Keep this matched to the web dev origin. The template pins `pnpm dev:web` to
# port 3000 so Auth.js callback URLs stay stable.
AUTH_URL="http://localhost:3000"
# Set this to your production origin before launch.
# It powers canonical URLs, sitemap.xml, robots.txt host metadata, and
# structured data URLs. Leave it blank during local development if needed.
NEXT_PUBLIC_SITE_URL=""

# Database (Prisma)
# Optional for multiple local clones with the same directory name:
# COMPOSE_PROJECT_NAME="my-template-project"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
# Change POSTGRES_DB and POSTGRES_PORT per clone when multiple projects need
# local Postgres at the same time. Keep DATABASE_URL in sync.
POSTGRES_DB="app_template"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_template?schema=public"

# Native (Expo)
# iOS Simulator:    http://localhost:3000
# Android Emulator: http://10.0.2.2:3000
# Physical device:  http://<machine-local-ip>:3000
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Optional seed overrides
SEED_EMAIL="dev@example.com"
SEED_DEMO_EMAIL="demo@example.com"
