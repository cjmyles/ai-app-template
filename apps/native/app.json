{
	"expo": {
		"name": "native",
		"slug": "native",
		"version": "1.0.0",
		"scheme": "native",
		"platforms": ["ios", "android", "web"],
		"newArchEnabled": true,
		"experiments": {
			"typedRoutes": true
		},
		"plugins": [
			"expo-router",
			[
				"expo-dev-client",
				{
					"launchMode": "most-recent",
					"addGeneratedScheme": true
				}
			]
		]
	}
}
