{
	"name": "ai-app-template",
	"private": true,
	"packageManager": "pnpm@10.29.3",
	"scripts": {
		"dev:web": "pnpm --filter web dev",
		"dev:native": "pnpm --filter native run start",
		"dev:native:lan": "pnpm --filter native run start:lan",
		"dev:native:tunnel": "pnpm --filter native run start:tunnel",
		"dev:native:dev-client": "pnpm --filter native run start:dev-client",
		"dev:native:dev-client:lan": "pnpm --filter native run start:dev-client:lan",
		"dev:native:dev-client:tunnel": "pnpm --filter native run start:dev-client:tunnel",
		"dev:ios": "pnpm --filter native run ios",
		"dev:android": "pnpm --filter native run android",
		"build": "pnpm -r build",
		"test": "pnpm -r --if-present test",
		"test:native": "pnpm --filter native run test",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check . && pnpm lint:guard:raw-colors && pnpm lint:guard:prisma-client-imports && pnpm lint:guard:prisma-types-sync && pnpm lint:guard:generated-enums && pnpm lint:guard:file-naming && pnpm lint:guard:no-migrations",
		"check:ci": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test",
		"validate:final": "pnpm typecheck && pnpm lint",
		"format": "biome format --write .",
		"gen:types:enums": "node ./scripts/generate-shared-enums.mjs",
		"lint:guard:raw-colors": "bash ./scripts/check-raw-colors.sh",
		"lint:guard:prisma-client-imports": "bash ./scripts/check-prisma-client-imports.sh",
		"lint:guard:prisma-types-sync": "bash ./scripts/check-prisma-types-sync.sh",
		"lint:guard:generated-enums": "node ./scripts/generate-shared-enums.mjs --check",
		"lint:guard:file-naming": "bash ./scripts/check-file-naming.sh",
		"lint:guard:no-migrations": "bash ./scripts/check-no-migrations.sh",
		"db:generate": "pnpm --filter web db:generate",
		"db:push": "pnpm --filter web db:push",
		"db:push:force-reset": "pnpm --filter web db:push:force-reset",
		"db:seed": "pnpm --filter web db:seed",
		"db:seed:baseline": "pnpm --filter web db:seed:baseline",
		"db:seed:demo": "pnpm --filter web db:seed:demo",
		"db:reset": "pnpm db:push:force-reset && pnpm db:seed:demo",
		"native:doctor": "pnpm --filter native run doctor"
	},
	"engines": {
		"node": ">=20.19.4 <21"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4"
	}
}
